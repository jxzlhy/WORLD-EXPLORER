[
  {
    "id": "cn-yuyuan-garden",
    "name": "豫园",
    "nameEn": "Yu Garden",
    "type": "heritage",
    "countryId": "CN",
    "longitude": 121.4927,
    "latitude": 31.2271,
    "summary": "明嘉靖年间的江南园林,四百余年闹市中的山水。三穗堂、玉玲珑、九曲桥——一步一景的造园法度,把整座江南压缩进两公顷。",
    "story": [
      "豫园建于明嘉靖三十八年(1559),四川布政使潘允端为侍奉父亲而筑,「豫」取「愉悦老亲」之意。造园耗时二十余年,鼎盛时占地七十余亩,是江南古典园林的顶峰之作。",
      "园中镇园之宝「玉玲珑」是北宋花石纲遗物:高约三米、周身孔窍,焚香于顶,各孔冒烟;注水于顶,各孔喷泉——「百窍渗水」的奇石天下罕二。战乱中它被弃置街头,清康熙年间才归位园中。",
      "今天从豫园走出,穿过九曲桥就是城隍庙商圈——明代的山水与当代的市声只隔一道粉墙。这种「园与城」的紧贴,恰是江南园林在现代都市里最生动的活法。"
    ],
    "bestSeason": "3-5月(春花)与 9-11月(秋色)",
    "tags": [
      "世界遗产(扩展名录预备)",
      "园林",
      "明代",
      "江南"
    ],
